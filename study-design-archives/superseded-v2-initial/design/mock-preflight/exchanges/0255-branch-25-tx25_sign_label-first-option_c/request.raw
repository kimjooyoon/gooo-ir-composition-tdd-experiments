{"model":"multilingual","state":{"request":"{\"schema\":\"gooo/body-codegen-ir-search-state/v1\",\"stage\":\"choose_before_candidate_evaluation\",\"activity\":\"C25\",\"activity_id\":\"bodycodegen://activity/c25\",\"body_ir\":\"var label = \\\"neutral\\\"; if input \\u003c 0 { label = \\\"negative\\\" } else { label = \\\"nonnegative\\\" }; if label == __GOOO_BODY_HOLE_choice__ { return -1 } else { return 1 }\",\"intent\":\"Label the input as negative or nonnegative; return -1 for the negative label and 1 for the other label.\",\"training_test_count\":3,\"remaining_candidates\":[{\"id\":\"option_a\",\"expression\":\"\\\"negative\\\"\"},{\"id\":\"option_b\",\"expression\":\"\\\"nonnegative\\\"\"},{\"id\":\"option_c\",\"expression\":\"\\\"neutral\\\"\"}],\"prior_attempts\":[]}"},"questions":{"body_ir_search":{"type":"choice","instructions":"Choose one untried expression to fill the Gooo body hole. Use the declared intent and any prior failures or advisory observations. This choice will be typechecked and tested after selection.","criteria":{"option_a":"Try this exact expression: \"negative\"","option_b":"Try this exact expression: \"nonnegative\"","option_c":"Try this exact expression: \"neutral\""}}}}